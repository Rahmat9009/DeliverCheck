{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivercheck.dev/contracts/request/1.0.0",
  "title": "DeliverCheck request v1",
  "description": "A request to assess and, in a later implementation, safely repair rejected JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "input_format",
    "source_text",
    "target_schema",
    "explicit_rules"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "input_format": {
      "const": "json"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "target_schema": {
      "type": "object"
    },
    "explicit_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downstream_error": {
      "type": "string",
      "minLength": 1
    }
  }
}
