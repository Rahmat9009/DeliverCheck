    "input_format": "json",
    "source_text": "{\"shipment_id\":\"S-1\",\"dispatch_date\":\"05/06/2026\"}",
    "target_schema": {
      "type": "object",
      "required": ["shipment_id", "dispatch_date"],
      "properties": {
        "shipment_id": { "type": "string" },
