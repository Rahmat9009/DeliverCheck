{
  "name": "delivercheck",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first JSON contract validation for the DeliverCheck hackathon project.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "arena:simulate": "node --import tsx scripts/arena-simulation.ts",
    "arena:live": "node --import tsx scripts/arena-live.ts",
    "build": "tsc",
    "demo:core": "node --import tsx scripts/demo-core.ts",
    "sharedos:proof": "node --import tsx scripts/sharedos-proof.ts",
    "smoke:service": "node --import tsx scripts/smoke-service.ts",
    "start": "node dist/src/service/start.js",
    "test:deploy": "vitest run tests/deploy",
    "test:arena": "vitest run tests/arena",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aicoo/sharedos": "0.1.0-alpha.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
